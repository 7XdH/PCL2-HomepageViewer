{
  "name": "pcl-homepage-viewer-third-party",
  "version": "1.0.0",
  "private": true,
  "description": "Third-party Plain Craft Launcher (PCL) Custom.xaml homepage viewer with PCL-compatible visuals and events.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "build": "node tools/build-static.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"js/**/*.js\" \"tools/**/*.{js,mjs}\" \"api/**/*.js\" \"server.js\" \"*.json\" \"eslint.config.js\" \"README.md\"",
    "format:check": "prettier --check \"js/**/*.js\" \"tools/**/*.{js,mjs}\" \"api/**/*.js\" \"server.js\" \"*.json\" \"eslint.config.js\" \"README.md\"",
    "test:unit": "node --test tools/unit-tests.mjs",
    "test": "npm run test:unit && node tools/regression.mjs",
    "test:presets": "node tools/regression.mjs --presets",
    "test:all": "npm run test:unit && node tools/regression.mjs --all"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "pcl",
    "plain-craft-launcher",
    "xaml",
    "homepage",
    "viewer",
    "minecraft"
  ],
  "author": "WorldHim",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "prettier": "^3.9.10"
  }
}
